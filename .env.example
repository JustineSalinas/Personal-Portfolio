# Copy this file to .env.local and fill in the values. Never commit real keys.
# On Vercel, set the same names under Project > Settings > Environment Variables
# (Production), then redeploy: changed values only apply to new deployments.

# Chatbot route (/api/chat)
GEMINI_API_KEY=

# Contact form (/api/contact). The key looks like re_xxxxxxxx; paste it with
# no quotes and no spaces.
RESEND_API_KEY=
# Optional. Inbox for submissions (defaults to the email in src/data/index.ts).
CONTACT_TO_EMAIL=
# Sender. onboarding@resend.dev only delivers to the email on your Resend
# account; verify your own domain in Resend for real use.
CONTACT_FROM_EMAIL=Adrian Salinas <onboarding@resend.dev>

# Optional, not currently needed (the heatmap reads the public profile page).
GITHUB_TOKEN=
